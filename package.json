    "reka-ui": "^2.10.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul-vue": "^0.4.1",
    "vue": "^3.5.41",
    "vue-echarts": "^7.0.3",
